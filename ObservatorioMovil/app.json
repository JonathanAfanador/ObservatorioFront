{
  "expo": {
    "name": "Observatorio de Movilidad",
    "slug": "observatorio-transporte-girardot",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo-alcaldia.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F0F7F0"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "co.gov.girardot.observatorio"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo-alcaldia.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "co.gov.girardot.observatorio",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "name": "Observatorio de Transporte Público",
      "shortName": "Observatorio",
      "description": "Consulta rutas y paraderos del transporte público de Girardot, Cundinamarca",
      "themeColor": "#1B5E20",
      "backgroundColor": "#F0F7F0",
      "display": "standalone",
      "startUrl": "/"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "La app necesita tu ubicación para mostrarte los paraderos más cercanos."
        }
      ],
      "expo-font",
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "04c05b9f-ce18-4878-a97c-45400b853254"
      }
    }
  }
}
